# Database (MySQL) - sesuaikan dengan kredensial lokal Anda
DATABASE_URL="mysql://root:password@localhost:3306/event_attendance_db"

# Server
PORT=5000
FRONTEND_URL="http://localhost:5173"

# JWT
JWT_SECRET="ganti_dengan_secret_key_yang_kuat"
JWT_EXPIRES_IN="1d"

# SMTP (Nodemailer) - contoh menggunakan Gmail SMTP + App Password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="youremail@gmail.com"
SMTP_PASS="app_password_gmail"
SMTP_FROM="Event Attendance <youremail@gmail.com>"
